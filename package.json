{
  "name": "hiyori",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:generate": "nanoka generate && drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hiyori --local",
    "db:migrate:remote": "wrangler d1 migrations apply hiyori --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "discord:register": "node --env-file-if-exists=.dev.vars scripts/register-discord-commands.mjs",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nanokajs/core": "2.0.1",
    "@tanstack/react-query": "^5.105.0",
    "agents": "^0.31.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "vite-ssr-components": "^0.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider-legacy": "npm:@cloudflare/workers-oauth-provider@0.8.3",
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ],
    "overrides": {
      "esbuild@>=0.18.20 <0.28.1": "0.28.1",
      "undici@>=7 <7.30.1": "7.30.1",
      "fast-uri@>=3 <3.1.9": "3.1.9",
      "qs@>=6 <6.16.1": "6.16.1",
      "ip-address@>=10 <10.7.4": "10.7.4",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "sharp@>=0.35.0 <0.35.5": "0.35.5",
      "body-parser@>=2 <2.4.0": "2.4.0",
      "zod@>=4 <4.6.6": "4.6.7"
    }
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
