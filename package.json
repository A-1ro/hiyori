{
  "name": "hiyori",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:generate": "nanoka generate && drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hiyori --local",
    "db:migrate:remote": "wrangler d1 migrations apply hiyori --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "discord:register": "node --env-file-if-exists=.dev.vars scripts/register-discord-commands.mjs",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nanokajs/core": "1.9.0",
    "@tanstack/react-query": "^5.104.2",
    "agents": "^0.28.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "vite-ssr-components": "^0.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ],
    "overrides": {
      "esbuild@>=0.18.20 <0.28.1": "0.28.1",
      "undici@>=7 <7.29.1": "7.29.1",
      "fast-uri@>=3 <3.1.8": "3.1.8",
      "qs@>=6 <6.16.0": "6.16.0",
      "ip-address@>=10 <10.7.1": "10.7.1",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "sharp@>=0.35.0 <0.35.5": "0.35.5"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
